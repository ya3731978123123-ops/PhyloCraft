#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'Hippopotamus_amphibius'
[2] 'Balaenoptera_physalus'
[3] 'Bos_taurus'
[4] 'Sus_scrofa'
[5] 'Equus_caballus'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=15;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 4,
	100	 5,
	75	 4 5,
	44	 1 3,
	100	 3,
	100	 1,
	48	 1 2,
	10	 2 5,
	3	 3 4,
	3	 2 3,
	9	 3 5,
	2	 2 4,
	5	 1 4,
	0	 1 5,
;
END; [Splits]

