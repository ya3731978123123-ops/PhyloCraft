#nexus

BEGIN Taxa;
DIMENSIONS ntax=6;
TAXLABELS
[1] 'Homo_sapiens'
[2] 'Pan_troglodytes'
[3] 'Gorilla_gorilla'
[4] 'Pongo_abelii'
[5] 'Macaca_mulatta'
[6] 'Lemur_catta'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=6 nsplits=28;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 4,
	100	 5,
	100	 6,
	67	 5 6,
	69	 1 2 3,
	83	 1 2,
	100	 1,
	25	 4 5,
	10	 1 2 6,
	11	 3 4,
	3	 2 3,
	5	 1 2 4,
	2	 1 5 6,
	6	 4 6,
	8	 1 3,
	4	 3 6,
	2	 2 4,
	0	 2 5,
	1	 1 2 5,
	1	 1 3 4,
	1	 3 5,
	1	 1 6,
	1	 2 6,
	1	 1 3 5,
	0	 1 4,
	0	 1 3 6,
;
END; [Splits]

