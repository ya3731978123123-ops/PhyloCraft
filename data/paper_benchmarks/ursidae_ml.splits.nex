#nexus

BEGIN Taxa;
DIMENSIONS ntax=6;
TAXLABELS
[1] 'Ursus_maritimus'
[2] 'Ursus_arctos'
[3] 'Ursus_americanus'
[4] 'Tremarctos_ornatus'
[5] 'Ailuropoda_melanoleuca'
[6] 'Canis_lupus_familiaris'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=6 nsplits=18;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 4,
	100	 5,
	100	 6,
	87	 5 6,
	98	 1 2 3,
	33	 1 3,
	100	 3,
	100	 1,
	34	 2 3,
	32	 1 2,
	6	 4 6,
	7	 4 5,
	1	 2 4,
	1	 1 5 6,
	1	 1 3 4,
	1	 3 4,
	0	 1 2 4,
;
END; [Splits]

